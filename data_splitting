import pandas as pd
import os
from sklearn.model_selection import train_test_split

# -----------------------------
# CONFIG
# -----------------------------
file_path = "data_splitting\All_classes.csv"
skeleton_dir = "./jester_skeletons_output"

EXCLUDED_CLASSES = ["No gesture", "Doing other things"]

# -----------------------------
# STEP 1: LOAD DATA
# -----------------------------
df = pd.read_csv(
    file_path,
    sep=';',
    header=None,
    names=['video_id', 'label'],
    dtype={'video_id': str}
)

# -----------------------------
# STEP 2: CLEAN CORRUPTED LABELS
# -----------------------------
# Keep only valid text labels (remove numeric corruption)
df['label'] = df['label'].astype(str).str.extract(r'([A-Za-z ]+)', expand=False)

# Remove rows where label became NaN
df = df.dropna()

# -----------------------------
# STEP 3: REMOVE UNWANTED CLASSES
# -----------------------------
df = df[~df['label'].isin(EXCLUDED_CLASSES)]

# -----------------------------
# STEP 4: ADD FILE PATHS
# -----------------------------
df['file_path'] = df['video_id'].apply(
    lambda x: os.path.join(skeleton_dir, f"{x}.npy")
)

# Keep only existing files
df = df[df['file_path'].apply(os.path.exists)]

# -----------------------------
# STEP 5: ENCODE LABELS
# -----------------------------
label_to_index = {label: idx for idx, label in enumerate(sorted(df['label'].unique()))}
df['label_index'] = df['label'].map(label_to_index)

print(f"Total samples after cleaning: {len(df)}")
print(f"Total classes: {len(label_to_index)}")

# -----------------------------
# STEP 6: TRAIN / TEST SPLIT
# -----------------------------
train_df, test_df = train_test_split(
    df,
    test_size=0.2,
    stratify=df['label_index'],
    random_state=42
)

# -----------------------------
# STEP 7: TRAIN / VAL SPLIT
# -----------------------------
train_df, val_df = train_test_split(
    train_df,
    test_size=0.1,
    stratify=train_df['label_index'],
    random_state=42
)

# -----------------------------
# STEP 8: SAVE FILES
# -----------------------------
train_df.to_csv("train_split.csv", index=False)
val_df.to_csv("val_split.csv", index=False)
test_df.to_csv("test_split.csv", index=False)

print("Splits created successfully!")
print(f"Train: {len(train_df)}")
print(f"Val: {len(val_df)}")
print(f"Test: {len(test_df)}")